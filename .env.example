# Copy this file to .env.local and fill in real values. .env.local is gitignored; this file
# (.env.example) is the only one committed, and documents every required var.
#
# Local dev (recommended — no hosted Supabase project needed for Phase 1):
#   1. Install Docker Desktop (required by the Supabase CLI to run Postgres/Auth/Studio locally).
#   2. `npx supabase start` (uses supabase/config.toml, already committed in this repo).
#   3. Copy the "API URL" and "anon key" it prints into the two NEXT_PUBLIC_* vars below.
#      (They're stable per-machine once `supabase start` has run — 127.0.0.1:54321 + a fixed
#      local demo JWT — but always prefer the CLI's own printed output over guessing them.)
#   4. Confirmation emails sent by local signup aren't actually delivered — view/click them at
#      the local Inbucket inbox: http://127.0.0.1:54324.
#
# Hosted Supabase project (needed for Vercel deploys and for CI secrets — see README/CI notes):
#   Create a project at https://supabase.com/dashboard, then get these three values from
#   Project Settings -> API.

# --- Required for every environment (local + hosted) ---

# Public: safe to ship to the browser. The RLS-scoped "anon" API key + project URL.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used to build absolute links in auth emails (e.g. the signup-confirmation link's redirect
# target, app/auth/callback). Must match wherever the app is actually reachable.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only — NEVER prefix with NEXT_PUBLIC_, NEVER used in a Client Component ---

# Service-role key: bypasses Row Level Security entirely. Per AGENTS.md's Absolute Rules, this
# must never be shipped to the browser or used in any user-facing request path — only in
# trusted server-only contexts: CI test-user seeding (e2e/helpers/admin-client.ts) and local
# `supabase start` scripting. Get it from Project Settings -> API on a hosted project, or from
# `supabase start`'s printed output locally.
SUPABASE_SERVICE_ROLE_KEY=

# --- Not needed until Phase 6 (food lookup) — leave blank for Phase 1 ---

# USDA FoodData Central API key (free tier). Server-only, used by lib/lookup/usda.ts behind the
# /api/lookup/search proxy. See docs/architecture/food-weight-tracker.md §7.
USDA_FDC_API_KEY=
